          "telegram.org",
          "t.me",
          "telegram.me",
          "telegra.ph",
          "telegram-cdn.org",
          "tdesktop.com",
          "telesco.pe"
        ],
        "outbound": "http-tg"
      }
    ],
    "final": "socks-out"
