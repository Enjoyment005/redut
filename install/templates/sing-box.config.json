{
  "log": {
    "level": "error"
  },
  "dns": {
    "servers": [
      {
        "tag": "proxy-dns",
        "detour": "socks-out",
        "type": "https",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query"
      }
    ],
    "strategy": "ipv4_only",
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": [
        "198.18.0.1/15"
      ],
      "auto_route": false
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "socks-out",
      "server": "",
      "server_port": 0,
      "username": "",
      "password": "",
      "version": "5"
    },
    {
      "type": "http",
      "tag": "http-tg",
      "server": "",
      "server_port": 0,
      "username": "",
      "password": ""
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "tun-in",
        "action": "sniff",
        "timeout": "500ms"
      },
      {
