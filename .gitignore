# ── секреты: никогда не коммитить ──────────────────────────────────────────
servers.json
*secrets*.json
!*secrets*.example.json
profiles.json
config.local.json
*.key
*.pem
*.crt

# клиентские профили содержат приватные ключи устройств
install/clients/
*.conf
# ...но шаблоны узла — часть установщика, без них не ставится dnsmasq-узел.
# Прежнее «!templates/*.conf» не работало: шаблон со слэшем привязан к корню репозитория,
# а «*» не переходит через каталог dnsmasq/ — три файла молча не попадали в GitHub.
!install/templates/**/*.conf

# ── питон ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ── прочее ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.db
.idea/
.vscode/
